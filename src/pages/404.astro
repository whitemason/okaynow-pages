---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../consts';
---
<BaseLayout title="페이지를 찾을 수 없어요 · OkayNow" alt>
  <main class="wrap page">
    <p class="eyebrow">404</p>
    <h1>이 길은 막혀 있어요.</h1>
    <p>주소가 바뀌었거나 지워진 페이지예요. 차 화면의 QR을 다시 찍어 보세요.</p>
    <p class="links">
      <a href={url()}>홈으로 ›</a>
      <a href={url('privacy.html')}>개인정보 안내 ›</a>
    </p>
  </main>
</BaseLayout>

<style>
  .page { min-height: 60vh; padding-top: 96px; padding-bottom: 120px; display: flex; flex-direction: column; gap: 12px; }
  .eyebrow { margin: 0; }
  h1 { margin: 0; font-size: 40px; line-height: 1.1; }
  p { margin: 0; color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 12px; }
  a { text-decoration: none; }
</style>
